# Disable PHP script execution inside uploads directory
<FilesMatch "\.(php|phtml|php3|php4|php5|phar|inc|cgi|pl|sh|exe|py)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php.c>
    php_flag engine off
</IfModule>

Options -Indexes -ExecCGI
